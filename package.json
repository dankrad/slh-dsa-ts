{
  "name": "slh-dsa-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Independent TypeScript FIPS 205 SLH-DSA implementation with conformance tests",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:rust": "tsx scripts/rust-differential.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
